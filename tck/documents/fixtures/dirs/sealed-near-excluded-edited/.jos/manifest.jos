    "name": "sealed-near-excluded-edited",
    "version": "1.0.0"
  },
  "intention": {
    "objective": "A sealed folder: Only whole segments logs, replays and dev are excluded: a covered file under log"
  },
  "guardrails": {
    "limit": {
      "seconds": 10,
      "output_bytes": 65536,
      "retries": 0
    }
  },
  "orchestration": {
    "definitions": {
      "say": {
        "engine": "shell",
        "run": [
          "sh",
          "-c",
          "echo effect > sealed-near-excluded-edited.effect.txt"
        ]
      }
    },
    "flows": {
      "main": {
        "steps": [
          "say"
        ]
      }
    }
  },
