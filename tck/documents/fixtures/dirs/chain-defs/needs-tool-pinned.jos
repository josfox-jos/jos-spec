{
  "jos": {
    "version": "2.0.0",
    "kind": "flow"
  },
  "id": "needs-tool-pinned",
  "meta": {
    "name": "needs-tool-pinned",
    "version": "1.0.0"
  },
  "intention": {
    "objective": "A flow pinned to other content than its chain holds",
    "success_criteria": [
      {
        "exit": 0
      }
    ]
  },
  "guardrails": {
    "limit": {
      "seconds": 10,
      "output_bytes": 65536,
      "retries": 0
    }
  },
  "orchestration": {
    "definitions": {
      "main": {
        "use": "chaindefs.tool@^1.0.0"
      }
    },
    "flows": {
      "main": {
        "steps": [
          "main"
        ]
      }
    }
  },
  "requires": [
    {
      "kind": "artifact",
      "name": "chaindefs.tool",
      "digest": "art_cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    }
  ]
}
