{
  "jos": {
    "version": "2.0.0",
    "kind": "atom"
  },
  "id": "sandbox-deep-child",
  "meta": {
    "name": "sandbox-deep-child",
    "version": "1.0.0"
  },
  "intention": {
    "objective": "A child two folders below the sandbox",
    "success_criteria": [
      {
        "exit": 0
      }
    ]
  },
  "guardrails": {
    "limit": {
      "seconds": 5,
      "output_bytes": 65536,
      "retries": 0
    }
  },
  "execution": {
    "engine": "shell",
    "run": [
      "sh",
      "-c",
      "echo effect > sandbox-deep-child.effect.txt"
    ]
  }
}
