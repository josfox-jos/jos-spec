{
  "jos": {
    "version": "2.0.0",
    "kind": "atom"
  },
  "id": "avoid.substring",
  "meta": {
    "name": "avoid.substring",
    "version": "1.0.0"
  },
  "intention": {
    "objective": "avoid.substring",
    "success_criteria": [
      {
        "exit": 0
      }
    ]
  },
  "guardrails": {
    "avoid": [
      "curl",
      "rm -rf"
    ]
  },
  "execution": {
    "run": [
      "echo",
      "rm -rf /tmp/x"
    ]
  }
}
