{
  "jos": {
    "version": "2.0.0",
    "kind": "flow"
  },
  "id": "requires-artifact-exact-version",
  "meta": {
    "name": "requires-artifact-exact-version",
    "version": "1.0.0"
  },
  "intention": {
    "objective": "An artifact dependency pinned to an exact version",
    "success_criteria": [
      {
        "exit": 0
      }
    ]
  },
  "guardrails": {
    "limit": {
      "seconds": 10,
      "output_bytes": 65536,
      "retries": 0
    }
  },
  "orchestration": {
    "definitions": {
      "helper": {
        "jos": {
          "version": "2.0.0",
          "kind": "atom"
        },
        "id": "lib.helper",
        "meta": {
          "name": "helper",
          "version": "1.2.0"
        },
        "intention": {
          "objective": "A helper the flow depends on"
        },
        "execution": {
          "run": [
            "echo",
            "helper"
          ]
        }
      },
      "main": {
        "use": "lib.helper@^1.0.0"
      }
    },
    "flows": {
      "main": {
        "steps": [
          "main"
        ]
      }
    }
  },
  "requires": [
    {
      "kind": "artifact",
      "name": "lib.helper",
      "version": "1.2.0"
    }
  ]
}
