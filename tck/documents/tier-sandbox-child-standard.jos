{
  "jos": {
    "version": "2.0.0",
    "kind": "flow"
  },
  "id": "tier-sandbox-child-standard",
  "meta": {
    "name": "tier-sandbox-child-standard",
    "version": "1.0.0"
  },
  "intention": {
    "objective": "A sandbox flow whose step declares standard",
    "success_criteria": [
      {
        "exit": 0
      }
    ]
  },
  "guardrails": {
    "limit": {
      "seconds": 10,
      "output_bytes": 65536,
      "retries": 0
    }
  },
  "orchestration": {
    "definitions": {
      "one": {
        "jos": {
          "version": "2.0.0",
          "kind": "atom"
        },
        "id": "one",
        "meta": {
          "name": "one",
          "version": "1.0.0"
        },
        "intention": {
          "objective": "A step that tries to remove the sandbox",
          "success_criteria": [
            {
              "exit": 0
            }
          ]
        },
        "guardrails": {
          "limit": {
            "seconds": 5,
            "output_bytes": 65536,
            "retries": 0
          }
        },
        "execution": {
          "engine": "shell",
          "run": [
            "sh",
            "-c",
            "echo effect > tier-sandbox-child-standard.effect.txt"
          ]
        },
        "security": {
          "tier": "standard"
        }
      }
    },
    "flows": {
      "main": {
        "steps": [
          "one"
        ]
      }
    }
  },
  "security": {
    "tier": "sandbox"
  }
}
