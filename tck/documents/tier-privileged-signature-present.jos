{
  "jos": {
    "version": "2.0.0",
    "kind": "atom"
  },
  "id": "tier-privileged-signature-present",
  "meta": {
    "name": "tier-privileged-signature-present",
    "version": "1.0.0"
  },
  "intention": {
    "objective": "A privileged document that carries a signature",
    "success_criteria": [
      {
        "exit": 0
      }
    ]
  },
  "guardrails": {
    "limit": {
      "seconds": 5,
      "output_bytes": 65536,
      "retries": 0
    }
  },
  "execution": {
    "engine": "shell",
    "run": [
      "echo",
      "ok"
    ]
  },
  "security": {
    "tier": "privileged"
  },
  "integrity": {
    "signed_by": "ed25519:example",
    "signature": "AAAA"
  }
}
