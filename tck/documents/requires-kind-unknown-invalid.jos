{
  "jos": {
    "version": "2.0.0",
    "kind": "atom"
  },
  "id": "requires-kind-unknown-invalid",
  "meta": {
    "name": "requires-kind-unknown-invalid",
    "version": "1.0.0"
  },
  "intention": {
    "objective": "An entry of a kind the format does not define",
    "success_criteria": [
      {
        "exit": 0
      }
    ]
  },
  "guardrails": {
    "limit": {
      "seconds": 5,
      "output_bytes": 65536,
      "retries": 0
    }
  },
  "execution": {
    "engine": "shell",
    "run": [
      "echo",
      "ok"
    ]
  },
  "requires": [
    {
      "kind": "plugin",
      "name": "x"
    }
  ]
}
