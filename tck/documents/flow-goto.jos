{
  "jos": {
    "version": "2.0.0",
    "kind": "flow"
  },
  "meta": {
    "name": "goto"
  },
  "orchestration": {
    "definitions": {
      "check": {
        "engine": "shell",
        "run": [
          "sh",
          "-c",
          "exit 3"
        ]
      },
      "middle": {
        "engine": "shell",
        "run": [
          "echo",
          "middle"
        ]
      },
      "fallback": {
        "engine": "shell",
        "run": [
          "echo",
          "fallback"
        ]
      }
    },
    "flows": {
      "main": {
        "steps": [
          "check",
          "middle",
          "fallback"
        ],
        "gates": {
          "check": {
            "kind": "auto",
            "expr": "exit == 0",
            "on_fail": "goto:fallback"
          }
        }
      }
    }
  }
}
