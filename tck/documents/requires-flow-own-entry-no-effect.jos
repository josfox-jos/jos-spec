{
  "jos": {
    "version": "2.0.0",
    "kind": "flow"
  },
  "id": "requires-flow-own-entry-no-effect",
  "meta": {
    "name": "requires-flow-own-entry-no-effect",
    "version": "1.0.0"
  },
  "intention": {
    "objective": "A flow whose own dependency is unsatisfied",
    "success_criteria": [
      {
        "exit": 0
      }
    ]
  },
  "guardrails": {
    "limit": {
      "seconds": 10,
      "output_bytes": 65536,
      "retries": 0
    }
  },
  "orchestration": {
    "definitions": {
      "one": {
        "engine": "shell",
        "run": [
          "sh",
          "-c",
          "echo effect > requires-flow-own-entry-no-effect.effect.txt"
        ]
      }
    },
    "flows": {
      "main": {
        "steps": [
          "one"
        ]
      }
    }
  },
  "requires": [
    {
      "kind": "mcp-server",
      "name": "github"
    }
  ]
}
