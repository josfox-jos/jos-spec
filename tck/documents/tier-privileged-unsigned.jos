{
  "jos": {
    "version": "2.0.0",
    "kind": "atom"
  },
  "id": "tier-privileged-unsigned",
  "meta": {
    "name": "tier-privileged-unsigned",
    "version": "1.0.0"
  },
  "intention": {
    "objective": "A privileged document needs a signature this runtime cannot verify",
    "success_criteria": [
      {
        "exit": 0
      }
    ]
  },
  "guardrails": {
    "limit": {
      "seconds": 5,
      "output_bytes": 65536,
      "retries": 0
    }
  },
  "execution": {
    "engine": "shell",
    "run": [
      "echo",
      "ok"
    ]
  },
  "security": {
    "tier": "privileged"
  }
}
