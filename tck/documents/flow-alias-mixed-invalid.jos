{
  "jos": {
    "version": "1.0.0",
    "kind": "flow"
  },
  "id": "flow.alias.mixed",
  "meta": {
    "name": "flow.alias.mixed"
  },
  "execution": {
    "flow": [
      {
        "invoke": "a"
      }
    ]
  },
  "orchestration": {
    "definitions": {
      "a": {
        "type": "shell",
        "command": "true"
      }
    },
    "flows": {
      "main": {
        "steps": [
          "a"
        ]
      }
    }
  }
}
