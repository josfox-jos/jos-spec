{
  "jos": {
    "version": "2.0.0",
    "kind": "flow"
  },
  "id": "requires-nested-flow",
  "meta": {
    "name": "requires-nested-flow",
    "version": "1.0.0"
  },
  "intention": {
    "objective": "A sub-flow whose step has an unsatisfied dependency",
    "success_criteria": [
      {
        "exit": 0
      }
    ]
  },
  "guardrails": {
    "limit": {
      "seconds": 10,
      "output_bytes": 65536,
      "retries": 0
    }
  },
  "orchestration": {
    "definitions": {
      "one": {
        "engine": "shell",
        "run": [
          "sh",
          "-c",
          "echo effect > requires-nested-flow.effect.txt"
        ]
      },
      "sub": {
        "jos": {
          "version": "2.0.0",
          "kind": "flow"
        },
        "id": "sub",
        "meta": {
          "name": "sub",
          "version": "1.0.0"
        },
        "intention": {
          "objective": "A sub-flow",
          "success_criteria": [
            {
              "exit": 0
            }
          ]
        },
        "guardrails": {
          "limit": {
            "seconds": 10,
            "output_bytes": 65536,
            "retries": 0
          }
        },
        "orchestration": {
          "definitions": {
            "deep": {
              "jos": {
                "version": "2.0.0",
                "kind": "atom"
              },
              "id": "deep",
              "meta": {
                "name": "deep",
                "version": "1.0.0"
              },
              "intention": {
                "objective": "A deep step that needs a service",
                "success_criteria": [
                  {
                    "exit": 0
                  }
                ]
              },
              "guardrails": {
                "limit": {
                  "seconds": 5,
                  "output_bytes": 65536,
                  "retries": 0
                }
              },
              "execution": {
                "engine": "shell",
                "run": [
                  "echo",
                  "ok"
                ]
              },
              "requires": [
                {
                  "kind": "service",
                  "name": "payments"
                }
              ]
            }
          },
          "flows": {
            "main": {
              "steps": [
                "deep"
              ]
            }
          }
        }
      }
    },
    "flows": {
      "main": {
        "steps": [
          "one",
          "sub"
        ]
      }
    }
  }
}
