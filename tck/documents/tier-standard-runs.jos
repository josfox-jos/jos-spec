{
  "jos": {
    "version": "2.0.0",
    "kind": "atom"
  },
  "id": "tier-standard-runs",
  "meta": {
    "name": "tier-standard-runs",
    "version": "1.0.0"
  },
  "intention": {
    "objective": "A standard step runs and its receipt records that it was not confined",
    "success_criteria": [
      {
        "exit": 0
      }
    ]
  },
  "guardrails": {
    "limit": {
      "seconds": 5,
      "output_bytes": 65536,
      "retries": 0
    }
  },
  "execution": {
    "engine": "shell",
    "run": [
      "echo",
      "ok"
    ]
  },
  "security": {
    "tier": "standard"
  }
}
