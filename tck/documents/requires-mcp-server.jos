{
  "jos": {
    "version": "2.0.0",
    "kind": "atom"
  },
  "id": "requires-mcp-server",
  "meta": {
    "name": "requires-mcp-server",
    "version": "1.0.0"
  },
  "intention": {
    "objective": "A 1.0.0 dependency on an MCP server the runtime does not provide",
    "success_criteria": [
      {
        "exit": 0
      }
    ]
  },
  "guardrails": {
    "limit": {
      "seconds": 5,
      "output_bytes": 65536,
      "retries": 0
    }
  },
  "execution": {
    "engine": "shell",
    "run": [
      "echo",
      "ok"
    ]
  },
  "requires": [
    {
      "kind": "mcp-server",
      "name": "github"
    }
  ]
}
