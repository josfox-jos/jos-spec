{
  "jos": {
    "version": "2.0.0",
    "kind": "atom"
  },
  "id": "requires-x-member-ignored",
  "meta": {
    "name": "requires-x-member-ignored",
    "version": "1.0.0"
  },
  "intention": {
    "objective": "An extension member that claims the entry is satisfied",
    "success_criteria": [
      {
        "exit": 0
      }
    ]
  },
  "guardrails": {
    "limit": {
      "seconds": 5,
      "output_bytes": 65536,
      "retries": 0
    }
  },
  "execution": {
    "engine": "shell",
    "run": [
      "echo",
      "ok"
    ]
  },
  "requires": [
    {
      "kind": "service",
      "name": "payments",
      "x-satisfied": true
    }
  ]
}
