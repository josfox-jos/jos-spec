{
  "jos": {
    "version": "2.0.0",
    "kind": "flow"
  },
  "meta": {
    "name": "release"
  },
  "orchestration": {
    "definitions": {
      "build": {
        "engine": "shell",
        "run": [
          "echo",
          "built"
        ]
      },
      "deploy": {
        "engine": "shell",
        "run": [
          "echo",
          "deployed"
        ]
      }
    },
    "flows": {
      "main": {
        "steps": [
          "build",
          "deploy"
        ],
        "gates": {
          "build": {
            "kind": "human"
          }
        }
      }
    }
  }
}
