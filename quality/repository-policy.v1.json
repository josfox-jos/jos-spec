        "enterprise_example",
        "ci"
      ]
    },
    "SDK": {
      "required_files": [
        "README.md",
        "LICENSE",
        "SECURITY.md",
        "CONTRIBUTING.md",
        "CHANGELOG.md"
      ],
      "required_capabilities": [
        "canonical_spec_link",
        "spec_compatibility_range",
        "tests",
        "conformance",
